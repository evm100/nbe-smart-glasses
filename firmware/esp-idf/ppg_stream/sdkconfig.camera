# Camera glasses (XIAO ESP32-S3 Sense: OV2640 + MAX30102) streaming to the NBE USB gateway.
# Applied on top of sdkconfig.defaults:
#   rm -f sdkconfig && idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.camera" build
# Then set the Device ID (e.g. GLS03) in menuconfig or edit PPG_DEVICE_ID below.
CONFIG_PPG_DEVICE_ID="GLS03"
CONFIG_PPG_SITE="glasses"
CONFIG_PPG_BOARD_NAME="XIAO-ESP32S3-Sense"
CONFIG_PPG_LINK_USB_BIN=y
CONFIG_PPG_TX_BUFFER_BYTES=32768
CONFIG_PPG_CAMERA=y
# Eye video for blink analysis (2026-11, see docs/EYE_CAMERA.md): ~50 fps, the same field of view as
# before. The sensor stays in CIF mode (half the lines of SVGA, so twice the frame rate at the same
# clock) and only its middle 160x160 CIF pixels (= 640 sensor px across, what SVGA WIN=480 + the 160
# crop showed) are scaled to the 128x128 frame; the middle 112x112 of that is sent (12.5 kB/frame,
# ~630 kB/s at 50 fps - the byte rate the 160x160 crop had at ~25 fps, ~75 % of the ~0.85 MB/s USB
# Serial/JTAG measured on GLS03).
# Before: SVGA WIN=480 on 240x240, crop 160 (25.6 kB), ~22-25 fps.
# Run time: "CAM MODE=CIF WIN=n" (n = 128..296 CIF px: smaller = finer pixels, narrower view),
# "CAM MODE=SVGA WIN=n" for the old mode (n = 128..600 SVGA px, ~25 fps at CLK=1).
CONFIG_PPG_CAM_SIZE_128=y
# no cap: every frame the sensor makes (~25 fps at CIF/CLK 3). The cap only skips whole sensor
# frames: 25 gives exactly every other one (use it on a slow Wi-Fi). Run time: "CAM FPS=n".
CONFIG_PPG_CAM_FPS=0
CONFIG_PPG_CAM_WINDOW=160
CONFIG_PPG_CAM_WIN_CIF=y
# sensor clock = 2 x 20 MHz / (CLKDIV + 1) = 10 MHz: 25 fps in CIF, line = 119 us.
# Measured 2026-11-25 on a spare XIAO S3 Sense (docs/EYE_CAMERA.md section 0): CLK=3 24.9 fps, <2 % lost;
# CLK=2 ~33 fps but 3-5 % lost in ~90 ms gaps; CLK=1 (50 fps nominal) fails: the board can't take
# that pixel clock (EV-VSYNC-OVF / FB-OVF). Run time: "CAM CLK=n". Retest on GLS03.
CONFIG_PPG_CAM_WIN_CLKDIV=3
CONFIG_PPG_CAM_CROP=112
# exposure in sensor lines (119 us each at CLKDIV 3); the sensor clamps it at one frame (336 lines =
# 40 ms at 25 fps), so the old 700 is no longer meaningful. 320 = 38 ms, about the brightest a frame
# allows. With the IR LED fitted, go down to ~50-85 lines (6-10 ms) for sharper eyelids.
CONFIG_PPG_CAM_EXPOSURE=320
# one queued frame of slack between the driver and the camera task (2 = the latest only)
CONFIG_PPG_CAM_FB_COUNT=3
# IR illuminator (docs/EYE_CAMERA.md): LED gate on D0 = GPIO1 (2026-11-25). On START..STOP at
# PPG_CAM_IR_DUTY (100 = DC); run time "CAM IR=0..100" (the live view's IR LED switch + brightness).
CONFIG_PPG_CAM_IR_GPIO=1
# PPG sensor settings: the Kconfig defaults (tuned for the glasses), same as the Wi-Fi nodes
# SCCB (camera control) on I2C port 1; the MAX30102 keeps port 0 (CONFIG_PPG_I2C_PORT)
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
# 240 MHz is required: at IDF's default 160 the camera driver fell behind (cam_hal EV-VSYNC-OVF) and
# only ~3 frames/min got out; at 240 (what the Arduino-era sketch ran at) the sensor's ~25 fps all arrive
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# camera driver task on core 1, away from the USB interrupts, the USB tx task and our camera task (all
# core 0; core 1 otherwise runs only the PPG sensor task). On core 0 the zoom at clkdiv 1 overran the
# driver (EV-VSYNC-OVF, one frame then 4 s timeouts). Frame buffers stay in PSRAM.
CONFIG_CAMERA_CORE1=y
