# Camera glasses (XIAO ESP32-S3 Sense: OV2640 + MAX30102) streaming to the NBE USB gateway.
# Applied on top of sdkconfig.defaults:
#   rm -f sdkconfig && idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.camera" build
# Then set the Device ID (e.g. GLS03) in menuconfig or edit PPG_DEVICE_ID below.
CONFIG_PPG_DEVICE_ID="GLS03"
CONFIG_PPG_SITE="glasses"
CONFIG_PPG_BOARD_NAME="XIAO-ESP32S3-Sense"
CONFIG_PPG_LINK_USB_BIN=y
CONFIG_PPG_TX_BUFFER_BYTES=32768
CONFIG_PPG_CAMERA=y
CONFIG_PPG_CAM_SIZE_240=y
CONFIG_PPG_CAM_FPS=15
# PPG sensor settings: the Kconfig defaults (tuned for the glasses), same as the Wi-Fi nodes
# SCCB (camera control) on I2C port 1; the MAX30102 keeps port 0 (CONFIG_PPG_I2C_PORT)
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
# frame buffers in PSRAM (the XIAO Sense has 8 MB octal PSRAM; sdkconfig.defaults enables it)
CONFIG_CAMERA_CORE0=y
